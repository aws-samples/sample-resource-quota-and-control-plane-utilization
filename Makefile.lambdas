# Makefile.lambdas

# the two functions we build
FUNCS       := ratelimit resourcequota

# top‐level dist dir
DIST_DIR    := dist

# Go entry points
RATELIMIT_SRC     := cmd/ratelimit/main.go
RESOURCEQUOTA_SRC := cmd/resourcequota/main.go

.PHONY: all $(FUNCS) clean $(FUNCS:%=clean-%)

all: $(FUNCS)

# build+zip for each function
ratelimit: clean-ratelimit
	mkdir -p $(DIST_DIR)/ratelimit
	GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -trimpath -o $(DIST_DIR)/ratelimit/bootstrap $(RATELIMIT_SRC)
	cd $(DIST_DIR)/ratelimit && zip ratelimit.zip bootstrap

resourcequota: clean-resourcequota
	mkdir -p $(DIST_DIR)/resourcequota
	GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build -trimpath -o $(DIST_DIR)/resourcequota/bootstrap $(RESOURCEQUOTA_SRC)
	cd $(DIST_DIR)/resourcequota && zip resourcequota.zip bootstrap

# clean everything
clean: $(FUNCS:%=clean-%)

clean-ratelimit:
	rm -rf $(DIST_DIR)/ratelimit

clean-resourcequota:
	rm -rf $(DIST_DIR)/resourcequota

